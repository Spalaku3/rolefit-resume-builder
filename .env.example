# Run python scripts/setup_local.py for local setup. Never commit a real .env.
APP_PASSWORD=
SESSION_SECRET=
APP_ENV=development
COOKIE_SECURE=false
APP_TIMEZONE=America/Chicago
DATABASE_URL=sqlite:///./data/rolefit.db
# Confirm the account is on the free plan before enabling Groq.
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Only allowlisted, verified zero-price :free models are eligible.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-oss-20b:free,openai/gpt-oss-120b:free
# Optional local OpenAI-compatible endpoint. Include /v1. Own hardware required.
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:20b
# Optional server-side fonts that YOU are licensed to use. Not distributed here.
RESUME_FONT_REGULAR=
RESUME_FONT_BOLD=
